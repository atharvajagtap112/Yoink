<?xml version="1.0" encoding="utf-8"?>
<!--
  Landmarks-only view: no camera preview, just the skeleton drawn on the ink
  canvas. The camera still runs (the analyzer feeds MediaPipe) — we never attach
  its surface, so nothing of the image is shown. Chrome is a top identity bar and
  a bottom control panel; the hand canvas is the hero between them.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <com.yoink.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top identity bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/starting"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/peers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="@string/offline"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom control panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center"
            android:text="@string/gesture_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/camera_toggle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_primary_pill"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:textColor="@color/on_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:text="@string/camera_off" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/overlay_perm"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="46dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_ghost_pill"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:text="@string/grant_overlay" />

            <Button
                android:id="@+id/enable_capture"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="46dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_ghost_pill"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:text="@string/enable_capture" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
